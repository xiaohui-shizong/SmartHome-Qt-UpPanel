  <property name="styleSheet">
   <string notr="true">
QWidget#HardwarePage{background-color: #F5F7FA;}
QPushButton{background-color:#4A90D9; color:white; border:none; border-radius:6px; font-size:13px; padding:6px 12px;}
QPushButton:hover{background-color:#357ABD;}
QPushButton:pressed{background-color:#2A5F9E;}
QPushButton#btn_alarm_on{background-color:#E74C3C;}
QPushButton#btn_alarm_off{background-color:#95A5A6;}
QPushButton#btn_autoMode{background-color:#27AE60;}
QPushButton#btn_autoMode[checked=true]{background-color:#E67E22;}
QLabel{font-size:12px; color:#333;}
QDoubleSpinBox{font-size:12px; border:1px solid #ccc; border-radius:4px; padding:2px; min-width:60px;}
QSlider::groove:horizontal{background:#ddd; height:8px; border-radius:4px;}
QSlider::handle:horizontal{background:#4A90D9; width:16px; border-radius:8px;}
QGroupBox{font-size:13px; font-weight:bold; color:#2C3E50; border:1px solid #BDC3C7; border-radius:8px; margin-top:10px; padding-top:8px;}
QGroupBox::title{subcontrol-origin:margin; left:10px; padding:0 5px;}
QRadioButton{font-size:12px;}
   </string>
