QWidget#LoginWidget{background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1a1a2e, stop:0.5 #16213e, stop:1 #1a1a2e);}
QLabel{color: #a0c4ff; font-size:14px;}
QLineEdit{border:2px solid rgba(255,255,255,0.25); border-radius:10px; background:#FFFFFF; padding:6px 16px; font-size:14px; color:#303133;}
QLineEdit:focus{border:2px solid #409eff;}
QPushButton{background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #409eff, stop:1 #2b7de9); color:#FFFFFF; border:none; border-radius:12px; font-size:14px; min-height:36px; font-weight:bold;}
QPushButton:hover{background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5cb6ff, stop:1 #409eff);}
QPushButton:pressed{background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #287de8, stop:1 #1c6dd4);}
QRadioButton{color:#a0c4ff; font-size:13px;}
QComboBox{border:2px solid rgba(255,255,255,0.25); border-radius:10px; background:#FFFFFF; font-size:13px; padding:4px 8px; color:#303133;}
QDoubleSpinBox{border:2px solid rgba(255,255,255,0.25); border-radius:10px; background:#FFFFFF; color:#303133;}
QSlider::groove:horizontal{background:rgba(255,255,255,0.2); height:8px; border-radius:4px;}
QSlider::handle:horizontal{background:#409eff; width:18px; height:18px; border-radius:9px; margin:-5px 0;}
QProgressBar{border-radius:8px; background:rgba(255,255,255,0.15); text-align:center; color:#a0c4ff;}
QProgressBar::chunk{background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #409eff, stop:1 #2b7de9); border-radius:8px;}
